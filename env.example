# Stripe — get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Get this after creating a webhook endpoint (see README for the walkthrough)
STRIPE_WEBHOOK_SECRET=whsec_...

# Used to build success/cancel redirect URLs. Set to your real domain in
# production (e.g. https://callback.vercel.app) and leave unset locally —
# it falls back to the request's own host.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
